<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SLTB" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_dark</item>
        <item name="colorPrimaryContainer">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/text_primary_dark</item>

        <item name="colorSecondary">@color/secondary_dark</item>
        <item name="colorSecondaryContainer">@color/secondary_dark</item>
        <item name="colorOnSecondary">@color/text_primary_dark</item>

        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="colorOutline">@color/ue_divider</item>

        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Common widget defaults -->
        <item name="materialButtonStyle">@style/Widget.SLTB.Button</item>
        <item name="toolbarStyle">@style/Widget.SLTB.Toolbar</item>
        <item name="chipStyle">@style/Widget.SLTB.Chip</item>
        <item name="textInputStyle">@style/Widget.SLTB.TextInputLayout</item>
    </style>

    <style name="Theme.SLTB" parent="Base.Theme.SLTB" />

    <!-- Widgets mapped to palette -->
    <style name="Widget.SLTB.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="backgroundTint">@color/primary_dark</item>
        <item name="rippleColor">@color/ue_white_50</item>
    </style>

    <style name="Widget.SLTB.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/surface_dark</item>
        <item name="titleTextColor">@color/text_primary_dark</item>
        <item name="subtitleTextColor">@color/text_secondary_dark</item>
        <item name="navigationIconTint">@color/text_primary_dark</item>
    </style>

    <style name="Widget.SLTB.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="chipStrokeColor">@color/primary_dark</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="checkedIconTint">@color/primary_dark</item>
    </style>

    <style name="Widget.SLTB.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/ue_white_10</item>
        <item name="boxStrokeColor">@color/primary_dark</item>
        <item name="android:textColorHint">@color/text_secondary_dark</item>
    </style>
</resources>