<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/appointment_gradient_background"
    android:fillViewport="true"
    android:padding="24dp"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Floating Shapes -->
        <ImageView
            android:id="@+id/shapeOne"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="-100dp"
            android:layout_marginStart="-100dp"
            android:alpha="0"
            android:src="@drawable/floating_shape"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/shapeTwo"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginEnd="-50dp"
            android:layout_marginTop="100dp"
            android:alpha="0"
            android:src="@drawable/floating_shape"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Logo Container with Glass Effect -->
        <androidx.cardview.widget.CardView
            android:id="@+id/logoContainer"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="32dp"
            app:cardCornerRadius="60dp"
            app:cardElevation="12dp"
            android:alpha="0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="24dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/unnamed" />

            <!-- Glass effect overlay -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/ue_white_10" />
        </androidx.cardview.widget.CardView>

        <!-- Title with enhanced typography -->
        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:alpha="0"
            android:elevation="4dp"
            android:text="SLTB Booking"
            android:textColor="@color/text_primary_dark"
            android:textSize="36sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/logoContainer" />

        <!-- Subtitle with improved styling -->
        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Sign in to continue with SLTB Booking"
            android:textSize="16sp"
            android:alpha="0"
            android:elevation="4dp"
            android:textColor="@color/text_secondary_dark"
            android:letterSpacing="0.01"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView" />

        <!-- Support tagline under subtitle -->
        <TextView
            android:id="@+id/textViewTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0"
            android:elevation="4dp"
            android:text="Book SLTB buses quickly and securely"
            android:textColor="@color/ue_white_50"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView2" />

        <!-- Input Fields Container Card with Glass Effect -->
        <androidx.cardview.widget.CardView
            android:id="@+id/inputContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            android:visibility="invisible"
            app:layout_constraintTop_toBottomOf="@+id/textViewTagline">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/card_background">

                <!-- Email Input with modern styling -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/emailInputLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundColor="@color/ue_white_10"
                    app:boxStrokeColor="@color/primary_dark"
                    app:hintTextColor="@color/text_primary_dark">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTextEmailPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Email or Phone Number"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/text_primary_dark"
                        android:textColorHint="@color/ue_white_50"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password Input with modern styling -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/passwordInputLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:boxBackgroundColor="@color/ue_white_10"
                    app:boxStrokeColor="@color/primary_dark"
                    app:hintTextColor="@color/text_primary_dark"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="@color/text_primary_dark">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTextPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Password"
                        android:inputType="textPassword"
                        android:textColor="@color/text_primary_dark"
                        android:textColorHint="@color/ue_white_50"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Sign In Button with gradient -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSignIn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="Sign In"
            android:textSize="16sp"
            android:visibility="invisible"
            android:textStyle="bold"
            app:cornerRadius="28dp"
            app:elevation="8dp"
            android:backgroundTint="@color/primary_dark"
            app:layout_constraintTop_toBottomOf="@+id/inputContainer" />

        <!-- Forgot Password with modern styling -->
        <TextView
            android:id="@+id/textViewForgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackground"
            android:padding="8dp"
            android:text="Forgot Password?"
            android:textColor="@color/text_primary_dark"
            android:alpha="0"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/buttonSignIn" />

        <!-- Sign Up Container with enhanced styling -->
        <LinearLayout
            android:id="@+id/signUpContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:alpha="0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textViewForgotPassword">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New to SLTB Booking? "
                android:textColor="@color/text_secondary_dark"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textViewSignUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp"
                android:text="Sign Up"
                android:textColor="@color/text_primary_dark"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Footer with modern styling -->
        <LinearLayout
            android:id="@+id/footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:alpha="0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/signUpContainer"
            app:layout_constraintVertical_bias="1.0">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:alpha="0.8"
                app:srcCompat="@drawable/copyright" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SLTB Booking 2025. All Rights Reserved"
                android:textColor="@color/text_secondary_dark"
                android:textSize="12sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>